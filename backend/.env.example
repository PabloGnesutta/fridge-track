PORT=3033
NODE_ENV=development

# Public base URL used to build the one-click link in verification emails
# (see src/services/authService.js's buildVerificationLink). Optional -
# falls back to http://localhost:PORT, which is only right for local dev;
# set this to the real deployed origin in production.
APP_BASE_URL=

# Push notifications
VAPID_PUBLIC_KEY=
NX9UxAU6Xo6CuhEUbvgAGb9lwyDmEN1U8
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_CHECK_INTERVAL_MS=

# Email (see src/services/emailService.js) - all optional; sendEmail()
# throws a clear error if SMTP_HOST/SMTP_USER/SMTP_PASS are missing rather
# than silently no-op'ing, since (unlike push/recipes) nothing calls it
# automatically yet.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_APP_NAME=FridgeTrack
