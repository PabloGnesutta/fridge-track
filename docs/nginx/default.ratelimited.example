# Global rate-limiting zones - defined once here since this whole file is
# your /etc/nginx/sites-available/default, loaded directly inside nginx's
# `http {}` context (via sites-enabled) - no separate conf.d/snippets file
# needed for a single-file setup like this one. `limit_req_zone`/
# `limit_conn_zone` MUST live at this top level (illegal inside a `server{}`
# block); the `limit_conn`/`limit_req` USAGE lines below, inside each server
# block, are what actually turns a zone on for that app.
#
# perip_general: a generous per-IP baseline (30 req/s, burst=80 nodelay) so
#   one real page load never trips it. These apps have no bundler - a single
#   load fires off a couple dozen requests nearly simultaneously (every JS
#   module as its own file, CSS, manifest/icons/service worker, plus several
#   boot-time /api/* calls) all counted against the same per-IP bucket. An
#   earlier, tighter version of this zone (10r/s, burst=20) actually broke
#   every app's page load - real traffic exhausted the burst instantly and
#   got 429'd along with any bots, so a page would start rendering and then
#   stall on whatever requests landed past the limit. This zone is meant to
#   only catch a sustained flood, not a real browser's one-time burst -
#   don't tighten it back down without testing an actual page load against
#   it first. A script hammering one endpoint in a loop still gets
#   throttled well before 30r/s sustained. Applied to EVERY app below.
# perip_strict: a tight per-IP limit (5 req/MIN) for routes that cost real
#   money/quota per hit (email) or are just abuse-prone (login/signup) -
#   applied below to fridge-track's auth/email routes and car-track's
#   signup/login. Safe to keep tight since these routes are only ever hit a
#   handful of times per real user session, unlike general page/asset loads.
#   Add a matching location block to any other app's own auth routes the
#   same way if they see similar abuse.
# perip_conn: caps concurrent connections per IP (40), independent of
#   request rate - cheap insurance against connection-flood-style abuse,
#   loosened alongside perip_general above for the same reason (a real page
#   load with several boot-time API calls plus asset requests can briefly
#   hold more than a couple connections open at once, especially over
#   HTTP/1.1).
limit_req_zone $binary_remote_addr zone=perip_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=perip_strict:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=perip_conn:10m;

# 429 instead of nginx's default 503 when a limit trips, and log it at `warn`
# (not the default `error`) so a real traffic spike doesn't read as a server
# fault when you're scanning logs later.
limit_req_status 429;
limit_conn_status 429;
limit_req_log_level warn;

##########################
# General hardening/perf #
##########################
# Hides the nginx version from the `Server:` response header and default
# error pages - free fingerprinting removed, costs nothing.
server_tokens off;

# gzip text-ish assets - these apps ship many small separate JS/CSS files
# (no bundler), so compressing them is a direct, cheap complement to the
# service-worker caching work: smaller transfers on top of fewer repeat
# fetches. Safe for any real client in 2026; no compatibility concerns.
# NOTE: `gzip on;` itself is deliberately NOT repeated here - your
# nginx.conf's http{} block already sets it (Debian/Ubuntu's stock default),
# and this file's top-level directives load into that exact same http{}
# context via sites-enabled, so redefining it is a hard "duplicate
# directive" error, not an override. Only the settings nginx.conf leaves
# commented out are added here.
gzip_vary on;
gzip_min_length 256;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

# TLS hardening. ssl_ciphers/session cache/timeout/tickets are safe to set
# here (nginx.conf doesn't touch them) - an ECDHE/CHACHA20-only cipher list
# (works with both RSA and ECDSA certs, deliberately excludes DHE suites so
# this doesn't depend on a `ssl_dhparam` file existing/being strong - none
# was configured before this change), a shared session cache/timeout to
# speed up repeat visits, and session tickets turned off since they can
# weaken forward secrecy unless the key is rotated, which nothing here does.
#
# ssl_protocols and ssl_prefer_server_ciphers are NOT set here, unlike the
# first draft of this file - your nginx.conf's http{} block already sets
# both (`ssl_protocols TLSv1 TLSv1.1 TLSv1.2 TLSv1.3;` and
# `ssl_prefer_server_ciphers on;`), so redefining them here hits the same
# duplicate-directive error gzip did. Fixing those two for real means
# editing nginx.conf directly (see docs/nginx/README.md's "nginx.conf
# changes" section) - dropping TLSv1/TLSv1.1 there is the actual point of
# this hardening pass; leaving this file's copy in would have silently
# failed to achieve it even if nginx.conf's duplicate weren't a hard error.
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;


map $http_x_forwarded_proto $redirect_scheme {
    default $scheme;
    https https;
}

server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$request_uri;
}

# Every real vhost this box serves, explicitly listed (not `server_name _;`)
# - this is what makes `$host` in the redirect below safe. The original
# single `server_name _;` catch-all matched (and 301-redirected using)
# *any* Host header a request came in with, including one an attacker sets
# by hand when hitting the bare IP directly - a classic Host-header-trust
# footgun (nginx will happily reply "301 https://evil.com/..." to a request
# whose Host header says "evil.com", even though this server has nothing to
# do with that domain). Restricting server_name to the known list means
# this block is only ever reached for one of these exact hosts, so `$host`
# here can only ever be one of them by the time nginx gets this far.
server {
        listen 80;
        server_name pablognesutta.com websynth.pablognesutta.com tracker.pablognesutta.com
                    car.pablognesutta.com fridge.pablognesutta.com snap.pablognesutta.com
                    sueldo.pablognesutta.com sonar.pablognesutta.com al.pablognesutta.com;
        return 301 https://$host$request_uri;
}

# Add any new vhost's domain to the list above BEFORE pointing DNS at this
# box, or its first requests will 444 here instead of redirecting.

########
# ROOT #
########
server {
        listen 443 ssl http2;
        server_name pablognesutta.com;
        ssl_certificate /etc/letsencrypt/live/pablognesutta.com-0001/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/pablognesutta.com-0001/privkey.pem;

        # HSTS on the bare domain only (not includeSubDomains) - deliberately
        # scoped narrow since several unrelated hobby-project subdomains live
        # under pablognesutta.com and includeSubDomains would force ALL of
        # them (including any not-yet-created one) into HTTPS-only for as
        # long as a visiting browser remembers this header, which is hard to
        # walk back quickly if a future subdomain isn't HTTPS-ready yet.
        add_header Strict-Transport-Security "max-age=31536000" always;

        limit_conn perip_conn 40;
        limit_req zone=perip_general burst=80 nodelay;

        access_log /var/log/nginx/root.access.log;
        error_log /var/log/nginx/root.error.log warn;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $redirect_scheme;

        location / {
                proxy_pass http://localhost:3004;
        }
}

