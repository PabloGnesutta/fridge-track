#################
# Audio Library #
#################
server {
        listen 443 ssl http2;
        server_name    al.pablognesutta.com;
        ssl_certificate /etc/letsencrypt/live/al.pablognesutta.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/al.pablognesutta.com/privkey.pem;

        limit_conn perip_conn 40;
        limit_req zone=perip_general burst=80 nodelay;

        access_log /var/log/nginx/al.access.log;
        error_log /var/log/nginx/al.error.log warn;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $redirect_scheme;

        # signup (/api/auth/user, only live when SIGNUP_FLAG=enabled),
        # login (/api/auth/sesion), and email verification
        # (/api/auth/confirmar-email) are the routes worth guarding here -
        # signup/verification can trigger an outbound SMTP send, same
        # reasoning as fridge-track's strict zone above.
        location ~ ^/api/auth/(user|sesion|confirmar-email)$ {
                limit_req zone=perip_strict burst=3 nodelay;
                proxy_pass http://localhost:3005;
        }

        location / {
                proxy_pass http://localhost:3005;
        }
}

# Catch-all for any TLS handshake whose SNI/Host doesn't match one of the
# vhosts above (a bot scanning the bare IP directly, mostly) - without this,
# nginx silently falls back to whichever 443 block appears first in this
# file (ROOT) as the default for the socket, quietly serving that site's
# real content to traffic that was never addressed to it. `default_server`
# here overrides that implicit choice. A cert is still required to complete
# *any* TLS handshake on this socket regardless of SNI match, so this reuses
# ROOT's own cert purely to have something to present - `return 444` then
# closes the connection immediately with no HTTP response at all. (Newer
# nginx (1.19.4+) can skip presenting a cert entirely via
# `ssl_reject_handshake on;` instead - not used here since this box is on an
# older version; revisit if nginx is ever upgraded.)
server {
        listen 443 ssl http2 default_server;
        server_name _;
        ssl_certificate /etc/letsencrypt/live/pablognesutta.com-0001/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/pablognesutta.com-0001/privkey.pem;
        return 444;
}



Certificate is saved at: /etc/letsencrypt/live/al.pablognesutta.com/fullchain.pem
Key is saved at:         /etc/letsencrypt/live/al.pablognesutta.com/privkey.pem