###############
# Car tracker #
###############
server {
        listen 443 ssl http2;
        server_name    car.pablognesutta.com;
        ssl_certificate /etc/letsencrypt/live/pablognesutta.com-0002/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/pablognesutta.com-0002/privkey.pem;

        limit_conn perip_conn 40;
        limit_req zone=perip_general burst=80 nodelay;

        access_log /var/log/nginx/car.access.log;
        error_log /var/log/nginx/car.error.log warn;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $redirect_scheme;

        # car-track's own auth is just signup/login (no email-verification
        # flow, no invites - see backend/src/http/apiRouter.js there), so
        # those are the only two routes worth the strict zone.
        location ~ ^/api/(signup|login)$ {
                limit_req zone=perip_strict burst=3 nodelay;
                proxy_pass http://localhost:3201;
        }

        location / {
                proxy_pass http://localhost:3201;
        }
}

##################
# Fridge tracker #
##################
server {
        listen 443 ssl http2;
        server_name    fridge.pablognesutta.com;
        ssl_certificate /etc/letsencrypt/live/pablognesutta.com-0002/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/pablognesutta.com-0002/privkey.pem;

        limit_conn perip_conn 40;
        limit_req zone=perip_general burst=80 nodelay;

        access_log /var/log/nginx/fridge.access.log;
        error_log /var/log/nginx/fridge.error.log warn;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $redirect_scheme;

        # Tighter limit specifically on the routes that send email or touch
        # auth - signup/resend-verification/verify-email can all trigger an
        # outbound email, and homes/invite is the admin-only invite route
        # (see backend/src/services/homeService.js). This is the directive
        # that actually stops a bot from re-exhausting the SMTP quota; the
        # baseline above only guards against raw request-flooding.
        location ~ ^/api/(signup|login|resend-verification|verify-email|homes/invite)$ {
                limit_req zone=perip_strict burst=3 nodelay;
                proxy_pass http://localhost:3202;
        }

        location / {
                proxy_pass http://localhost:3202;
        }

}

