#Sonar (mobile)
server {
        listen 443 ssl;
        server_name sonar.pablognesutta.com;
        proxy_ssl_name sonar.pablognesutta.com;
        ssl_certificate /etc/letsencrypt/live/pablognesutta.com-0001/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/pablognesutta.com-0001/privkey.pem;

        limit_conn perip_conn 40;
        limit_req zone=perip_general burst=80 nodelay;

        location / {
                proxy_pass http://localhost:3125;
        }
        proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
}
